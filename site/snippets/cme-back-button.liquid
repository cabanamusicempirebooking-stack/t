{% comment %}
  CME iOS Back Button
  ───────────────────
  Shows a floating back button on product, cart, collection, and page screens
  when there is browser history to go back to. Hidden on the home page and
  when history length is 1 (direct entry). Pure JS + CSS — no Liquid logic needed.
{% endcomment %}

<button
  id="cme-back-btn"
  class="cme-back-btn"
  aria-label="Go back"
  style="display:none"
  onclick="history.back()"
>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M15 18l-6-6 6-6"/>
  </svg>
</button>

<style>
  .cme-back-btn {
    position: fixed;
    top: calc(env(safe-area-inset-top, 0px) + 14px);
    left: 16px;
    z-index: 200;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: none;
    background: rgba(11, 11, 11, 0.82);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    box-shadow: 0 2px 12px rgba(0,0,0,0.35);
    transition: opacity 0.15s ease, transform 0.15s ease;
  }
  .cme-back-btn:active {
    opacity: 0.7;
    transform: scale(0.93);
  }
  .cme-back-btn svg {
    width: 18px;
    height: 18px;
    display: block;
  }
  /* Hide on desktop — nav handles back there */
  @media (min-width: 768px) {
    .cme-back-btn { display: none !important; }
  }
</style>

<script>
(function () {
  var btn = document.getElementById('cme-back-btn');
  if (!btn) return;

  function update() {
    var isHome = (window.location.pathname === '/' || window.location.pathname === '');
    // Show when there is history and we're not on the home page
    var show = !isHome && window.history.length > 1;
    btn.style.display = show ? 'flex' : 'none';
  }

  // Run on load and after Shopify view transitions (if enabled)
  update();
  document.addEventListener('shopify:section:load', update);
  window.addEventListener('popstate', update);

  // Also support Capacitor's navigation events
  document.addEventListener('ionRouteDidChange', update);
})();
</script>
