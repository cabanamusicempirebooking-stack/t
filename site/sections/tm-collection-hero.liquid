{% comment %} SECTION: tm-collection-hero.liquid — CME-styled header for collection pages {% endcomment %}
<style>
.tm-coll-hero {
  background: #f7f5f2;
  padding: 72px 64px 52px;
  position: relative;
  border-bottom: 1px solid rgba(13,13,13,0.08);
  overflow: hidden;
}
.tm-coll-hero::before {
  content: '';
  position: absolute;
  top: 0; left: 0;
  width: 80px; height: 3px;
  background: #ff2a2a;
}
.tm-coll-hero::after {
  content: attr(data-title);
  position: absolute;
  right: -20px; top: 50%;
  transform: translateY(-50%);
  font-family: 'Bebas Neue', sans-serif;
  font-size: 260px; letter-spacing: -10px; line-height: 1;
  color: rgba(13,13,13,0.035);
  user-select: none; pointer-events: none;
  white-space: nowrap;
}

.tm-ch-eyebrow {
  display: flex; align-items: center; gap: 12px;
  font-family: 'DM Sans', sans-serif;
  font-size: 9px; font-weight: 500;
  letter-spacing: 4px; text-transform: uppercase;
  color: #ff2a2a; margin-bottom: 14px;
}
.tm-ch-eyebrow::before { content: ''; display: block; width: 24px; height: 1px; background: #ff2a2a; }

.tm-ch-title {
  font-family: 'Bebas Neue', sans-serif;
  font-size: clamp(56px, 9vw, 112px);
  line-height: 0.92; letter-spacing: 1px;
  color: #0d0d0d;
  position: relative; z-index: 1;
}

.tm-ch-desc {
  font-family: 'Cormorant Garamond', serif;
  font-style: italic; font-size: 19px; font-weight: 300;
  color: rgba(13,13,13,0.5); line-height: 1.7;
  margin-top: 18px; max-width: 520px;
  position: relative; z-index: 1;
}

.tm-ch-meta {
  display: flex; align-items: center; gap: 24px;
  margin-top: 28px;
  position: relative; z-index: 1;
}
.tm-ch-count {
  font-family: 'DM Sans', sans-serif;
  font-size: 9px; font-weight: 500;
  letter-spacing: 3px; text-transform: uppercase;
  color: rgba(13,13,13,0.4);
  padding: 6px 14px;
  border: 1px solid rgba(13,13,13,0.12);
  background: #fff;
}
.tm-ch-breadcrumb {
  font-family: 'DM Sans', sans-serif;
  font-size: 10px; color: rgba(13,13,13,0.35);
  display: flex; align-items: center; gap: 8px;
}
.tm-ch-breadcrumb a { color: inherit; text-decoration: none; transition: color 0.2s; }
.tm-ch-breadcrumb a:hover { color: #ff2a2a; }

@media (max-width: 767px) {
  .tm-coll-hero { padding: 56px 20px 36px; }
  .tm-coll-hero::after { font-size: 140px; right: -10px; }
  .tm-ch-title { font-size: clamp(44px, 14vw, 72px); }
  .tm-ch-desc { font-size: 16px; }
}
</style>

<section class="tm-coll-hero" data-title="{{ collection.title | upcase | truncate: 8, '' }}">
  <div class="tm-ch-breadcrumb">
    <a href="/pages/shop">Shop</a>
    <span>›</span>
    <span>{{ collection.title }}</span>
  </div>

  <div class="tm-ch-eyebrow" style="margin-top:16px;">{{ section.settings.eyebrow | default: 'Cabana Music Empire' }}</div>
  <h1 class="tm-ch-title">{{ collection.title }}</h1>

  {% if collection.description != blank %}
    <div class="tm-ch-desc">{{ collection.description }}</div>
  {% endif %}

  <div class="tm-ch-meta">
    <span class="tm-ch-count">{{ collection.products_count }} {% if collection.products_count == 1 %}Product{% else %}Products{% endif %}</span>
  </div>
</section>

{% schema %}
{
  "name": "CME Collection Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow Label", "default": "Cabana Music Empire" }
  ],
  "presets": [{ "name": "CME Collection Hero" }]
}
{% endschema %}
