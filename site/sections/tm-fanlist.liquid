    { "type": "text",     "id": "hero_title_line2",  "label": "Title Line 2 (outline)","default": "Movement" },
    { "type": "text",     "id": "hero_subtitle",     "label": "Subtitle",              "default": "Get exclusive drops, beats, and behind-the-scenes access before the rest of the world hears it." },
    { "type": "url",      "id": "apple_music_url",   "label": "Apple Music URL" },
    { "type": "url",      "id": "youtube_url",       "label": "YouTube URL" },
    { "type": "url",      "id": "spotify_url",       "label": "Spotify URL" },
    { "type": "url",      "id": "twitter_url",       "label": "Twitter / X URL" },
    { "type": "header",   "content": "Fan Capture Form" },
    { "type": "text",     "id": "cap_eyebrow",       "label": "Section Eyebrow",       "default": "Fan Access · No Cap" },
    { "type": "text",     "id": "cap_title_1",       "label": "Title Part 1",          "default": "First to" },
    { "type": "text",     "id": "cap_title_red",     "label": "Title Red Word",        "default": "Know." },
    { "type": "text",     "id": "cap_title_2",       "label": "Title Part 2",          "default": "First to Hear." },
    { "type": "textarea", "id": "cap_desc",          "label": "Description",           "default": "Drop your info and lock in. You'll get exclusive access to new music, song packs, merch releases, and content that never hits the timeline." },
    { "type": "text",     "id": "perk1_text",        "label": "Perk 1 Text",           "default": "Hear new songs and hook packs before they drop publicly." },
    { "type": "text",     "id": "perk2_text",        "label": "Perk 2 Text",           "default": "Fan-only pricing on songs with hooks and limited merch." },
    { "type": "text",     "id": "perk3_text",        "label": "Perk 3 Text",           "default": "No algorithm. Straight to your inbox or phone." },
    { "type": "text",     "id": "success_text",      "label": "Success Message",       "default": "Welcome to the movement. You'll be the first to know when something drops. Stay locked." },
    { "type": "header",   "content": "Stats Bar" },
    { "type": "text",     "id": "stat1_num",         "label": "Stat 1 Number",         "default": "3+" },
    { "type": "text",     "id": "stat1_lbl",         "label": "Stat 1 Label",          "default": "Albums" },
    { "type": "text",     "id": "stat2_num",         "label": "Stat 2 Number",         "default": "∞" },
    { "type": "text",     "id": "stat2_lbl",         "label": "Stat 2 Label",          "default": "Songs in Catalog" },
    { "type": "text",     "id": "stat3_num",         "label": "Stat 3 Number",         "default": "100%" },
    { "type": "text",     "id": "stat3_lbl",         "label": "Stat 3 Label",          "default": "Independent" }
  ],
  "blocks": [
    {
      "type": "preview_track",
      "name": "Preview Track",
      "settings": [
        { "type": "text", "id": "title",     "label": "Song Title",            "default": "Inner God" },
        { "type": "text", "id": "album",     "label": "Album / Project",       "default": "The Trinity EP" },
        { "type": "text", "id": "art_initials","label":"Art Initials (2-3 chars)","default":"IG" },
        { "type": "text", "id": "audio_url", "label": "Audio File URL (.mp3)", "info": "Admin → Content → Files → Upload .mp3 → copy URL → paste here." }
      ]
    }
  ],
  "presets": [{ "name": "TM Fan List" }]
}
{% endschema %}
