  "settings": [
    { "type": "header",   "content": "Hero / Music Preview" },
    { "type": "checkbox", "id": "show_badge",       "label": "Show Live Badge",       "default": true },
    { "type": "text",     "id": "badge_text",        "label": "Badge Text",            "default": "New Project Incoming — Get First Access" },
    { "type": "text",     "id": "hero_eyebrow",      "label": "Eyebrow",               "default": "Official Fan List · Est. 2024" },
