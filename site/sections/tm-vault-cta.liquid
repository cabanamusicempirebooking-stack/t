{% comment %}
  SECTION: tm-vault-cta.liquid
  Music Vault — Final closing CTA. Dark, bold, 3 buttons.
{% endcomment %}

<style>
.tm-vault-cta {
  background: #0d0d0d;
  padding: 120px 64px;
  position: relative;
  overflow: hidden;
  text-align: center;
}

/* Accent line at top */
.tm-vault-cta-rule {
  position: absolute; top: 0; left: 0; right: 0; height: 1px;
  background: linear-gradient(to right, transparent, rgba(255,42,42,0.2) 50%, transparent);
}

/* Grid pattern */
.tm-vault-cta-grid {
  position: absolute; inset: 0;
  background-image: linear-gradient(rgba(255,42,42,0.025) 1px,transparent 1px),
                    linear-gradient(90deg,rgba(255,42,42,0.025) 1px,transparent 1px);
  background-size: 72px 72px;
  mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 20%, transparent 100%);
  -webkit-mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 20%, transparent 100%);
  pointer-events: none;
}

/* Large red glow behind text */
.tm-vault-cta-glow {
  position: absolute; top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 700px; height: 500px;
  background: radial-gradient(ellipse, rgba(255,42,42,0.06) 0%, transparent 70%);
  pointer-events: none;
}

.tm-vault-cta-inner {
  max-width: 820px; margin: 0 auto;
  position: relative; z-index: 1;
}

/* Pulsing dot + badge */
.tm-vault-cta-badge {
  display: inline-flex; align-items: center; gap: 8px;
  font-family: 'DM Sans', sans-serif;
  font-size: 8px; font-weight: 500;
  letter-spacing: 3px; text-transform: uppercase;
  color: rgba(255,255,255,0.35);
  border: 1px solid rgba(255,255,255,0.1);
  padding: 8px 16px;
  margin-bottom: 40px;
}
.tm-vault-cta-dot {
  width: 6px; height: 6px; border-radius: 50%;
  background: #ff2a2a;
  animation: tmVaultDotPulse 2s ease-in-out infinite;
}
@keyframes tmVaultDotPulse {
  0%,100% { opacity: 1; box-shadow: 0 0 0 0 rgba(255,42,42,0.6); }
  50%      { opacity: 0.7; box-shadow: 0 0 0 6px rgba(255,42,42,0); }
}

.tm-vault-cta-title {
  font-family: 'Bebas Neue', sans-serif;
  font-size: clamp(52px, 9vw, 108px);
  line-height: 0.9; letter-spacing: -1px;
  color: #fff;
  margin-bottom: 32px;
}
.tm-vault-cta-title .tm-outline {
  color: transparent;
  -webkit-text-stroke: 2px rgba(255,255,255,0.15);
  display: block;
}
.tm-vault-cta-title .tm-red { color: #ff2a2a; }

.tm-vault-cta-body {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(18px, 2.5vw, 24px);
  font-weight: 300; font-style: italic;
  color: rgba(255,255,255,0.45);
  line-height: 1.65;
  margin-bottom: 56px;
  max-width: 620px; margin-left: auto; margin-right: auto;
}

.tm-vault-cta-actions {
  display: flex; align-items: center; justify-content: center;
  gap: 14px; flex-wrap: wrap;
  margin-bottom: 48px;
}

/* Primary red button */
.tm-vault-cta-btn-primary {
  font-family: 'DM Sans', sans-serif;
  font-size: 10px; font-weight: 500;
  letter-spacing: 2.5px; text-transform: uppercase;
  color: #fff; background: #ff2a2a;
  padding: 16px 44px;
  border: 1px solid #ff2a2a;
  text-decoration: none;
  display: inline-block;
  transition: background 0.25s, transform 0.25s;
}
.tm-vault-cta-btn-primary:hover { background: #e01f1f; transform: translateY(-2px); }

/* Outline white button */
.tm-vault-cta-btn-outline {
  font-family: 'DM Sans', sans-serif;
  font-size: 10px; font-weight: 500;
  letter-spacing: 2.5px; text-transform: uppercase;
  color: rgba(255,255,255,0.7);
  border: 1px solid rgba(255,255,255,0.18);
  padding: 16px 32px;
  text-decoration: none;
  display: inline-flex; align-items: center; gap: 10px;
  transition: border-color 0.25s, color 0.25s, transform 0.25s;
}
.tm-vault-cta-btn-outline:hover { border-color: rgba(255,255,255,0.55); color: #fff; transform: translateY(-2px); }

/* Closer line */
.tm-vault-cta-closer {
  font-family: 'DM Sans', sans-serif;
  font-size: 9px; letter-spacing: 2px; text-transform: uppercase;
  color: rgba(255,255,255,0.18);
}
.tm-vault-cta-closer a {
  color: rgba(255,255,255,0.35);
  text-decoration: underline; text-underline-offset: 3px;
  transition: color 0.2s;
}
.tm-vault-cta-closer a:hover { color: rgba(255,255,255,0.7); }

@media (max-width: 767px) {
  .tm-vault-cta { padding: 80px 24px; }
  .tm-vault-cta-glow { width: 360px; height: 320px; }
  .tm-vault-cta-actions { flex-direction: column; gap: 10px; }
  .tm-vault-cta-btn-primary,
  .tm-vault-cta-btn-outline {
    width: 100%;
    justify-content: center; text-align: center;
    padding: 15px 20px;
  }
}
</style>

<section class="tm-vault-cta" id="vault-join">
  <div class="tm-vault-cta-rule"></div>
  <div class="tm-vault-cta-grid"></div>
  <div class="tm-vault-cta-glow"></div>

  <div class="tm-vault-cta-inner">

    {% if section.settings.badge_text != blank %}
      <div class="tm-vault-cta-badge">
        <div class="tm-vault-cta-dot"></div>
        {{ section.settings.badge_text }}
      </div>
    {% endif %}

    <div class="tm-vault-cta-title">
      <span>{{ section.settings.title_line1 | default: 'Real Supporters' }}</span>
      <span class="tm-outline">{{ section.settings.title_line2 | default: 'Tap Into' }}</span>
      <span class="tm-red">{{ section.settings.title_line3 | default: 'The Vault' }}</span>
    </div>

    <p class="tm-vault-cta-body">{{ section.settings.body | default: 'Unreleased music. Exclusive beats. App-only discounts. First access to every drop. This is where the real community lives.' }}</p>

    <div class="tm-vault-cta-actions">
      {% if section.settings.btn1_link != blank %}
        <a href="{{ section.settings.btn1_link }}" class="tm-vault-cta-btn-primary">
          {{ section.settings.btn1_text | default: 'Join the Vault' }}
        </a>
      {% endif %}
      {% if section.settings.btn2_link != blank %}
        <a href="{{ section.settings.btn2_link }}" class="tm-vault-cta-btn-outline">
          {{ section.settings.btn2_text | default: 'Browse Music' }} →
        </a>
      {% endif %}
      {% if section.settings.btn3_link != blank %}
        <a href="{{ section.settings.btn3_link }}" class="tm-vault-cta-btn-outline">
          {{ section.settings.btn3_text | default: 'Get Beats' }} →
        </a>
      {% endif %}
    </div>

    {% if section.settings.closer != blank %}
      <div class="tm-vault-cta-closer">{{ section.settings.closer }}</div>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Vault CTA",
  "settings": [
    { "type": "text", "id": "badge_text", "label": "Badge Text", "default": "Vault Access Open" },
    { "type": "text", "id": "title_line1", "label": "Title Line 1 (solid white)", "default": "Real Supporters" },
    { "type": "text", "id": "title_line2", "label": "Title Line 2 (outline)", "default": "Tap Into" },
    { "type": "text", "id": "title_line3", "label": "Title Line 3 (red)", "default": "The Vault" },
    { "type": "textarea", "id": "body", "label": "Body Text", "default": "Unreleased music. Exclusive beats. App-only discounts. First access to every drop. This is where the real community lives." },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "btn1_text", "label": "Button 1 Text (primary red)", "default": "Join the Vault" },
    { "type": "url",  "id": "btn1_link", "label": "Button 1 Link" },
    { "type": "text", "id": "btn2_text", "label": "Button 2 Text", "default": "Browse Music" },
    { "type": "url",  "id": "btn2_link", "label": "Button 2 Link" },
    { "type": "text", "id": "btn3_text", "label": "Button 3 Text", "default": "Get Beats" },
    { "type": "url",  "id": "btn3_link", "label": "Button 3 Link" },
    { "type": "header", "content": "Footer" },
    { "type": "text", "id": "closer", "label": "Closing Line", "default": "In the Vault." }
  ],
  "presets": [{ "name": "Vault CTA" }]
}
{% endschema %}
