{% comment %}
  SECTION: tm-vault-live.liquid
  Music Vault — Live events, upcoming releases, social alert CTAs.
{% endcomment %}

<style>
.tm-vault-live {
  background: #f7f5f2;
  padding: 100px 64px;
  position: relative;
  overflow: hidden;
}
.tm-vault-live-rule {
  position: absolute; top: 0; left: 64px; right: 64px; height: 1px;
  background: linear-gradient(to right, transparent, rgba(13,13,13,0.08), transparent);
}
.tm-vault-live-inner {
  max-width: 1100px; margin: 0 auto;
  position: relative; z-index: 1;
}

/* Header row */
.tm-vault-live-header {
  display: flex; align-items: flex-start;
  justify-content: space-between; gap: 48px;
  margin-bottom: 64px;
}
.tm-vault-live-eyebrow {
  font-family: 'DM Sans', sans-serif;
  font-size: 9px; font-weight: 500;
  letter-spacing: 4px; text-transform: uppercase;
  color: #ff2a2a; margin-bottom: 14px;
  display: flex; align-items: center; gap: 12px;
}
.tm-vault-live-eyebrow::before {
  content: ''; display: block; width: 28px; height: 1px; background: #ff2a2a;
}
.tm-vault-live-title {
  font-family: 'Bebas Neue', sans-serif;
  font-size: clamp(40px, 6vw, 68px);
  line-height: 0.92; letter-spacing: -0.5px; color: #0d0d0d;
}
.tm-vault-live-intro {
  font-family: 'Cormorant Garamond', serif;
  font-size: 18px; font-weight: 300; font-style: italic;
  color: rgba(13,13,13,0.5); line-height: 1.6;
  max-width: 380px; flex-shrink: 0;
  padding-top: 8px;
}

/* Event list */
.tm-vault-live-events { display: flex; flex-direction: column; gap: 0; }

.tm-vault-live-event {
  display: flex; align-items: center; gap: 32px;
  padding: 28px 0;
  border-bottom: 1px solid rgba(13,13,13,0.07);
  text-decoration: none;
  transition: background 0.2s;
  position: relative;
}
.tm-vault-live-event:first-child { border-top: 1px solid rgba(13,13,13,0.07); }
.tm-vault-live-event:hover .tm-vault-live-event-arrow { transform: translateX(4px); }

.tm-vault-live-event-date {
  min-width: 64px;
  display: flex; flex-direction: column; align-items: center;
  gap: 2px;
}
.tm-vault-live-event-month {
  font-family: 'DM Sans', sans-serif;
  font-size: 8px; font-weight: 500;
  letter-spacing: 3px; text-transform: uppercase;
  color: #ff2a2a;
}
.tm-vault-live-event-day {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 36px; line-height: 1; color: #0d0d0d;
  letter-spacing: 0;
}

.tm-vault-live-event-divider {
  width: 1px; height: 40px;
  background: linear-gradient(to bottom, transparent, rgba(13,13,13,0.12), transparent);
  flex-shrink: 0;
}

.tm-vault-live-event-body { flex: 1; min-width: 0; }
.tm-vault-live-event-name {
  font-family: 'DM Sans', sans-serif;
  font-size: 15px; font-weight: 500;
  color: #0d0d0d; margin-bottom: 4px;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.tm-vault-live-event-meta {
  font-family: 'DM Sans', sans-serif;
  font-size: 9px; letter-spacing: 2px; text-transform: uppercase;
  color: rgba(13,13,13,0.35);
}

.tm-vault-live-event-tag {
  font-family: 'DM Sans', sans-serif;
  font-size: 7px; font-weight: 500;
  letter-spacing: 2.5px; text-transform: uppercase;
  padding: 4px 10px; border-radius: 0;
  white-space: nowrap; flex-shrink: 0;
}
.tm-vault-live-event-tag.live   { background: rgba(255,42,42,0.1); color: #ff2a2a; }
.tm-vault-live-event-tag.stream { background: rgba(13,13,13,0.06); color: rgba(13,13,13,0.5); }
.tm-vault-live-event-tag.drop   { background: #0d0d0d; color: #fff; }

.tm-vault-live-event-arrow {
  font-size: 16px; color: rgba(13,13,13,0.2);
  transition: transform 0.2s; flex-shrink: 0;
}

/* Social alert strip */
.tm-vault-live-alert {
  margin-top: 56px;
  background: #0d0d0d;
  padding: 36px 48px;
  display: flex; align-items: center; justify-content: space-between; gap: 32px;
}
.tm-vault-live-alert-text { flex: 1; min-width: 0; }
.tm-vault-live-alert-label {
  font-family: 'DM Sans', sans-serif;
  font-size: 9px; font-weight: 500;
  letter-spacing: 3px; text-transform: uppercase;
  color: rgba(255,255,255,0.35); margin-bottom: 8px;
}
.tm-vault-live-alert-heading {
  font-family: 'Bebas Neue', sans-serif;
  font-size: clamp(22px, 3vw, 34px);
  letter-spacing: 0.5px; color: #fff; line-height: 1;
}
.tm-vault-live-alert-heading em {
  color: #ff2a2a; font-style: normal;
}
.tm-vault-live-alert-btns {
  display: flex; gap: 10px; flex-shrink: 0;
}
.tm-vault-live-social-btn {
  font-family: 'DM Sans', sans-serif;
  font-size: 9px; font-weight: 500;
  letter-spacing: 2px; text-transform: uppercase;
  color: rgba(255,255,255,0.75);
  border: 1px solid rgba(255,255,255,0.15);
  padding: 12px 20px;
  text-decoration: none;
  display: inline-flex; align-items: center; gap: 8px;
  transition: border-color 0.2s, color 0.2s;
  white-space: nowrap;
}
.tm-vault-live-social-btn:hover { border-color: #ff2a2a; color: #ff2a2a; }
.tm-vault-live-social-btn svg { width: 14px; height: 14px; fill: currentColor; flex-shrink: 0; }

@media (max-width: 767px) {
  .tm-vault-live { padding: 64px 24px; }
  .tm-vault-live-rule { left: 24px; right: 24px; }
  .tm-vault-live-header { flex-direction: column; gap: 20px; margin-bottom: 40px; }
  .tm-vault-live-intro { max-width: 100%; }
  .tm-vault-live-event { gap: 16px; padding: 22px 0; }
  .tm-vault-live-event-name { white-space: normal; }
  .tm-vault-live-alert { flex-direction: column; align-items: flex-start; padding: 28px 24px; }
  .tm-vault-live-alert-btns { flex-direction: column; width: 100%; }
  .tm-vault-live-social-btn { justify-content: center; }
}
</style>

<section class="tm-vault-live" id="vault-live">
  <div class="tm-vault-live-rule"></div>
  <div class="tm-vault-live-inner">

    <div class="tm-vault-live-header">
      <div>
        <div class="tm-vault-live-eyebrow">{{ section.settings.eyebrow | default: 'Live & Upcoming' }}</div>
        <div class="tm-vault-live-title">{{ section.settings.title | default: 'Events & Drops' }}</div>
      </div>
      <p class="tm-vault-live-intro">{{ section.settings.intro | default: 'Be first to the stage, the stream, and the drop. Vault members get access first.' }}</p>
    </div>

    {% if section.blocks.size > 0 %}
      <div class="tm-vault-live-events">
        {% for block in section.blocks %}
          {% if block.type == 'event' %}
            <a
              href="{{ block.settings.link | default: '#' }}"
              class="tm-vault-live-event"
              {% if block.settings.link contains 'http' %}target="_blank" rel="noopener"{% endif %}
              {{ block.shopify_attributes }}
            >
              <div class="tm-vault-live-event-date">
                <div class="tm-vault-live-event-month">{{ block.settings.month }}</div>
                <div class="tm-vault-live-event-day">{{ block.settings.day }}</div>
              </div>
              <div class="tm-vault-live-event-divider"></div>
              <div class="tm-vault-live-event-body">
                <div class="tm-vault-live-event-name">{{ block.settings.name }}</div>
                <div class="tm-vault-live-event-meta">{{ block.settings.meta }}</div>
              </div>
              {% assign tag_type = block.settings.tag_type | default: 'stream' %}
              <div class="tm-vault-live-event-tag {{ tag_type }}">
                {{ block.settings.tag_label | default: 'Stream' }}
              </div>
              <div class="tm-vault-live-event-arrow">→</div>
            </a>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    <div class="tm-vault-live-alert">
      <div class="tm-vault-live-alert-text">
        <div class="tm-vault-live-alert-label">{{ section.settings.alert_label | default: 'Never miss a moment' }}</div>
        <div class="tm-vault-live-alert-heading">
          {{ section.settings.alert_heading | default: 'Follow for <em>live alerts</em>' }}
        </div>
      </div>
      <div class="tm-vault-live-alert-btns">
        {% if section.settings.youtube_link != blank %}
          <a href="{{ section.settings.youtube_link }}" target="_blank" rel="noopener" class="tm-vault-live-social-btn">
            <svg viewBox="0 0 24 24"><path d="M21.8 8s-.2-1.4-.8-2c-.7-.8-1.6-.8-2-.9C16.2 5 12 5 12 5s-4.2 0-7 .1c-.4.1-1.3.1-2 .9-.6.6-.8 2-.8 2S2 9.6 2 11.2v1.5c0 1.6.2 3.2.2 3.2s.2 1.4.8 2c.7.8 1.7.7 2.2.8C6.8 19 12 19 12 19s4.2 0 7-.2c.4-.1 1.3-.1 2-.9.6-.6.8-2 .8-2s.2-1.6.2-3.2v-1.5C22 9.6 21.8 8 21.8 8zM9.8 14.5V9l5.5 2.8-5.5 2.7z"/></svg>
            YouTube
          </a>
        {% endif %}
        {% if section.settings.instagram_link != blank %}
          <a href="{{ section.settings.instagram_link }}" target="_blank" rel="noopener" class="tm-vault-live-social-btn">
            <svg viewBox="0 0 24 24"><path d="M12 2.2c3.2 0 3.6 0 4.8.1 3.3.1 4.8 1.7 4.9 4.9.1 1.2.1 1.6.1 4.8 0 3.2 0 3.6-.1 4.8-.1 3.2-1.7 4.8-4.9 4.9-1.2.1-1.6.1-4.8.1-3.2 0-3.6 0-4.8-.1-3.2-.1-4.8-1.7-4.9-4.9C2.2 15.6 2.2 15.2 2.2 12c0-3.2 0-3.6.1-4.8.1-3.2 1.7-4.8 4.9-4.9 1.2-.1 1.6-.1 4.8-.1zM12 0C8.7 0 8.3 0 7.1.1 2.7.3.3 2.7.1 7.1.0 8.3 0 8.7 0 12c0 3.3 0 3.7.1 4.9.2 4.4 2.6 6.8 7 7C8.3 24 8.7 24 12 24c3.3 0 3.7 0 4.9-.1 4.4-.2 6.8-2.6 7-7 .1-1.2.1-1.6.1-4.9 0-3.3 0-3.7-.1-4.9C23.7 2.7 21.3.3 16.9.1 15.7 0 15.3 0 12 0zm0 5.8a6.2 6.2 0 1 0 0 12.4 6.2 6.2 0 0 0 0-12.4zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.4-11.8a1.4 1.4 0 1 0 0 2.8 1.4 1.4 0 0 0 0-2.8z"/></svg>
            Instagram
          </a>
        {% endif %}
        {% if section.settings.tiktok_link != blank %}
          <a href="{{ section.settings.tiktok_link }}" target="_blank" rel="noopener" class="tm-vault-live-social-btn">
            <svg viewBox="0 0 24 24"><path d="M19.6 3.3A4.5 4.5 0 0 1 15.5 0h-3.2v15.6a2.6 2.6 0 1 1-2.6-2.5v-3.2A5.8 5.8 0 1 0 15.5 16V8.5a7.7 7.7 0 0 0 4.5 1.4V6.7a4.5 4.5 0 0 1-.4-.1 4.5 4.5 0 0 1 0-3.3z"/></svg>
            TikTok
          </a>
        {% endif %}
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Vault Live Events",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Live & Upcoming" },
    { "type": "text", "id": "title", "label": "Section Title", "default": "Events & Drops" },
    { "type": "textarea", "id": "intro", "label": "Intro Text", "default": "Be first to the stage, the stream, and the drop. Vault members get access first." },
    { "type": "header", "content": "Alert Strip" },
    { "type": "text", "id": "alert_label", "label": "Alert Label", "default": "Never miss a moment" },
    { "type": "text", "id": "alert_heading", "label": "Alert Heading", "default": "Follow for live alerts" },
    { "type": "header", "content": "Social Links" },
    { "type": "url", "id": "youtube_link", "label": "YouTube Channel" },
    { "type": "url", "id": "instagram_link", "label": "Instagram" },
    { "type": "url", "id": "tiktok_link", "label": "TikTok" }
  ],
  "blocks": [
    {
      "type": "event",
      "name": "Event",
      "settings": [
        { "type": "text", "id": "month", "label": "Month Abbreviation", "default": "JUL" },
        { "type": "text", "id": "day", "label": "Day", "default": "12" },
        { "type": "text", "id": "name", "label": "Event Name", "default": "Vault Live Session" },
        { "type": "text", "id": "meta", "label": "Location / Platform", "default": "YouTube Live · Free for Vault Members" },
        {
          "type": "select",
          "id": "tag_type",
          "label": "Tag Style",
          "options": [
            { "value": "live",   "label": "Live (red)" },
            { "value": "stream", "label": "Stream (grey)" },
            { "value": "drop",   "label": "Drop (black)" }
          ],
          "default": "stream"
        },
        { "type": "text", "id": "tag_label", "label": "Tag Text", "default": "Stream" },
        { "type": "url", "id": "link", "label": "Event Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vault Live Events",
      "blocks": [
        { "type": "event", "settings": { "month": "JUL", "day": "12", "name": "Vault Live Session — Unreleased Playback", "meta": "YouTube Live · Free for Vault Members", "tag_type": "live", "tag_label": "Live" } },
        { "type": "event", "settings": { "month": "JUL", "day": "19", "name": "AWAKE 4 Deluxe — Vault Early Access", "meta": "Digital Drop · Vault Members First", "tag_type": "drop", "tag_label": "Drop" } },
        { "type": "event", "settings": { "month": "AUG", "day": "02", "name": "Beat Pack Vol. 3 — Preview Stream", "meta": "Instagram Live · @tmafianie", "tag_type": "stream", "tag_label": "Stream" } }
      ]
    }
  ]
}
{% endschema %}
