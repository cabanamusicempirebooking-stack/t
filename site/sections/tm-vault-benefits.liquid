{% comment %}SECTION: tm-vault-benefits.liquid — Vault benefits grid{% endcomment %}

<style>
.tm-vb{--red:#ff2a2a;--k:#0d0d0d;--ease:cubic-bezier(.22,1,.36,1);font-family:'DM Sans',sans-serif}
.tm-vb *,.tm-vb *::before,.tm-vb *::after{box-sizing:border-box}
.tm-vb-section{background:var(--k);padding:96px 64px;border-top:1px solid rgba(255,255,255,.06)}
.tm-vb-header{text-align:center;margin-bottom:64px}
.tm-vb-eye{display:flex;align-items:center;justify-content:center;gap:12px;font-size:9px;font-weight:500;letter-spacing:4px;text-transform:uppercase;color:rgba(255,42,42,.85);margin-bottom:18px}
.tm-vb-eye::before,.tm-vb-eye::after{content:'';display:block;width:24px;height:1px;background:rgba(255,42,42,.5)}
.tm-vb-title{font-family:'Bebas Neue',sans-serif;font-size:clamp(44px,6vw,80px);line-height:.9;color:#f0ede8;letter-spacing:1px;margin-bottom:16px}
.tm-vb-desc{font-family:'Cormorant Garamond',serif;font-style:italic;font-size:18px;font-weight:300;color:rgba(240,237,232,.4);max-width:480px;margin:0 auto;line-height:1.65}
.tm-vb-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.06)}
.tm-vb-card{background:var(--k);padding:36px 28px;position:relative;overflow:hidden;transition:background .3s var(--ease)}
.tm-vb-card::after{content:'';position:absolute;bottom:0;left:0;right:0;height:2px;background:var(--red);transform:scaleX(0);transform-origin:left;transition:transform .4s var(--ease)}
.tm-vb-card:hover{background:#0f0f0f}
.tm-vb-card:hover::after{transform:scaleX(1)}
.tm-vb-icon{font-size:28px;margin-bottom:16px;display:block}
.tm-vb-card-title{font-family:'Bebas Neue',sans-serif;font-size:22px;letter-spacing:2px;color:#f0ede8;margin-bottom:10px}
.tm-vb-card-text{font-size:12px;line-height:1.7;color:rgba(240,237,232,.38);font-weight:300}
.tm-vb-card-line{position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(to right,transparent,rgba(255,42,42,.15),transparent)}

@media(max-width:1023px){.tm-vb-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:767px){
  .tm-vb-section{padding:72px 24px}
  .tm-vb-grid{grid-template-columns:repeat(2,1fr)}
  .tm-vb-card{padding:28px 20px}
}
</style>

<section class="tm-vb tm-vb-section">
  <div class="tm-vb-header">
    <div class="tm-vb-eye">{{ section.settings.eyebrow }}</div>
    <h2 class="tm-vb-title">{{ section.settings.heading }}</h2>
    <p class="tm-vb-desc">{{ section.settings.subheading }}</p>
  </div>

  <div class="tm-vb-grid">
    {% for block in section.blocks %}
      <div class="tm-vb-card" {{ block.shopify_attributes }}>
        <div class="tm-vb-card-line"></div>
        <span class="tm-vb-icon">{{ block.settings.icon }}</span>
        <div class="tm-vb-card-title">{{ block.settings.title }}</div>
        <div class="tm-vb-card-text">{{ block.settings.description }}</div>
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Vault Benefits",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"VAULT ACCESS"},
    {"type":"text","id":"heading","label":"Heading","default":"What's In The Vault"},
    {"type":"textarea","id":"subheading","label":"Subheading","default":"Everything inside stays inside. Until you're in."}
  ],
  "blocks":[
    {
      "type":"benefit",
      "name":"Benefit",
      "settings":[
        {"type":"text","id":"icon","label":"Emoji Icon","default":"🎵"},
        {"type":"text","id":"title","label":"Title","default":"Early Access"},
        {"type":"textarea","id":"description","label":"Description","default":"Hear new music before it drops on YouTube or streaming."}
      ]
    }
  ],
  "presets":[{
    "name":"Vault Benefits",
    "blocks":[
      {"type":"benefit","settings":{"icon":"🎵","title":"Early Access","description":"Hear new music before it drops on YouTube or streaming."}},
      {"type":"benefit","settings":{"icon":"🎬","title":"Exclusive Videos","description":"BTS footage, studio vlogs, and Osmo Action 6 content."}},
      {"type":"benefit","settings":{"icon":"🔓","title":"Unreleased Tracks","description":"Songs that never hit streaming — Vault only."}},
      {"type":"benefit","settings":{"icon":"💿","title":"Deluxe Editions","description":"Extended albums with bonus tracks and exclusive content."}},
      {"type":"benefit","settings":{"icon":"📲","title":"App-Only Drops","description":"Content only accessible through the T Mafianie app."}},
      {"type":"benefit","settings":{"icon":"🏷️","title":"Vault Discounts","description":"App-only promo codes on digital albums and merch."}},
      {"type":"benefit","settings":{"icon":"🔴","title":"Live Release Events","description":"First notice for live drops, listening sessions, and release parties."}},
      {"type":"benefit","settings":{"icon":"📧","title":"Private Updates","description":"Direct fan updates before any public announcement goes out."}}
    ]
  }]
}
{% endschema %}
