<!doctype html>
<html
  class="no-js{% if request.design_mode %} shopify-design-mode{% endif %}"
  lang="{{ request.locale.iso_code }}"
>
  <head>
    {%- render 'stylesheets' -%}

    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {% comment %} This a way to wait for main content to load when navigating to a new page so that the view transitions can work consistently {% endcomment %}
    <link
      rel="expect"
      href="#MainContent"
      blocking="render"
      id="view-transition-render-blocker"
    >

    {%- render 'meta-tags' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-schemes' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}

    {%- comment -%} CME iOS: Block PayPal/accelerated-checkout web components from auto-initializing {%- endcomment -%}
    <script>
    (function() {
      // Block Shopify's accelerated checkout web components before they register.
      var _define = customElements.define.bind(customElements);
      customElements.define = function(name, constructor, options) {
        if (
          name === 'shopify-accelerated-checkout-cart' ||
          name === 'shopify-payment-button' ||
          name === 'shopify-buy-button' ||
          name === 'more-payment-options-link' ||
          name === 'paypal-button' ||
          name === 'shopify-login-button' ||
          name === 'account-login-actions' ||
          name === 'shop-login-button'
        ) {
          _define(name, class extends HTMLElement {}, options);
          return;
        }
        _define(name, constructor, options);
      };

      // Block unauthorized payment window.open calls
      var _windowOpen = window.open.bind(window);
      var _checkoutAllowed = false;
      document.addEventListener('click', function(e) {
        var btn = e.target && e.target.closest('#checkout, [name="checkout"], .cart__checkout-button');
        if (btn) _checkoutAllowed = true;
        setTimeout(function() { _checkoutAllowed = false; }, 3000);
      }, true);
      window.open = function(url, target, features) {
        if (url && typeof url === 'string') {
          var lower = url.toLowerCase();
          var isPayment = lower.indexOf('paypal.com') > -1 ||
                          lower.indexOf('pay.google') > -1 ||
                          lower.indexOf('applepay') > -1 ||
                          lower.indexOf('checkout.shopify') > -1;
          if (isPayment && !_checkoutAllowed && !window._tmBsPaypalAllowed) {
            console.warn('[CME] Blocked unauthorized payment URL:', url);
            return null;
          }
        }
        return _windowOpen(url, target, features);
      };

      // ── iOS Login/Account Routing Fix ─────────────────────────────────────
      // Shopify's New Customer Accounts use shopify.com as auth provider.
      // Capacitor sees that external domain and opens Safari. The session
      // created in Safari is separate from the WebView — user appears logged
      // out in the app. Fix: intercept ALL link clicks, and for any account/
      // login/vault route force navigation inside the WebView via
      // window.location.href instead of letting it open externally.

      var INTERNAL_PATTERNS = [
        /\/account/,
        /\/challenge/,
        /\/password/,
        /\/pages\/vault/,
        /tmafianie\.com/,
        /shopify\.com\/[0-9]+\/account/,
        /shop\.app/
      ];

      var EXTERNAL_PATTERNS = [
        /checkout\.shopify\.com/,
        /\.myshopify\.com\/checkouts/,
        /paypal\.com/,
        /stripe\.com/,
        /youtube\.com/,
        /youtu\.be/,
        /spotify\.com/,
        /music\.apple\.com/,
        /instagram\.com/,
        /tiktok\.com/,
        /x\.com/,
        /twitter\.com/
      ];

      function isInternalURL(url) {
        if (!url || url.charAt(0) === '#') return true;
        if (url.charAt(0) === '/') return true;
        for (var i = 0; i < INTERNAL_PATTERNS.length; i++) {
          if (INTERNAL_PATTERNS[i].test(url)) return true;
        }
        for (var j = 0; j < EXTERNAL_PATTERNS.length; j++) {
          if (EXTERNAL_PATTERNS[j].test(url)) return false;
        }
        // Default: same host = internal
        try {
          var parsed = new URL(url, window.location.href);
          return parsed.host === window.location.host;
        } catch(e) { return true; }
      }

      document.addEventListener('click', function(e) {
        var link = e.target && e.target.closest('a[href]');
        if (!link) return;
        var href = link.getAttribute('href');
        if (!href || href.charAt(0) === '#') return;

        if (isInternalURL(href)) {
          // Force internal navigation — override any target="_blank"
          if (link.target === '_blank' || link.target === '_self') {
            e.preventDefault();
            console.log('[CME] Internal navigation allowed: ' + href);
            window.location.href = href;
          }
          // No target or target="_self" without _blank: let browser handle normally (stays in WebView)
        } else {
          console.log('[CME] External navigation opened: ' + href);
          // Let target="_blank" open externally as normal
        }
      }, true);

    })();
    </script>

    {%- comment -%} CME App — Safe Apple mobile/home-screen meta tags.
      These do not conflict with meta-tags.liquid (which handles SEO/OG/canonical).
      No service worker. No manifest. No offline logic.
    {%- endcomment -%}
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="{{ shop.name }}">
    <meta name="mobile-web-app-capable" content="yes">
    {%- comment -%} CME App — Apple touch icon for Add to Home Screen {%- endcomment -%}
    <link rel="apple-touch-icon" href="{{ 'apple-touch-icon.png' | asset_url }}">

    <!-- TM Custom Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&family=Cormorant+Garamond:ital,wght@0,300;1,300&display=swap" rel="stylesheet">
  </head>

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}
    <div id="header-group">
      {% sections 'header-group' %}
    </div>

    <script
      src="{{ 'critical.js' | asset_url }}"
      type="module"
      async
      blocking="render"
    ></script>

    <main
      id="MainContent"
      class="content-for-layout"
      role="main"
      data-page-transition-enabled="{{ settings.page_transition_enabled }}"
      data-product-transition="{{ settings.transition_to_main_product }}"
      data-template="{{ template }}"
    >
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'search-modal' %}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}

    {%- comment -%} CME mobile bottom navigation — mobile only, no JS, no checkout interaction {%- endcomment -%}
    {% render 'cme-bottom-nav' %}

    {%- comment -%} CME iOS back button — shows when history exists, hidden on home + desktop {%- endcomment -%}
    {% render 'cme-back-button' %}
  </body>
</html>
